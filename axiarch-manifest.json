    },
    {
      "path": "MARKET_STRATEGY.md",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": "llms.txt",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": "llms-full.txt",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": "social-preview.png",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".gitignore",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".markdownlint-cli2.jsonc",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".github/workflows/release.yml",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".github/workflows/lint.yml",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".github/CODEOWNERS",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".github/PULL_REQUEST_TEMPLATE.md",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".github/ISSUE_TEMPLATE",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    },
    {
      "path": ".github/dependabot.yml",
      "group": "source_docs",
      "owner": "axiarch-source",
      "policy": "skip"
    }
  ]
}
